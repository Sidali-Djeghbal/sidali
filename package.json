{
  "name": "sidali-djeghbal.dev",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "biome check . && tsc --noEmit",
    "db:backup": "wrangler d1 export sidali-notes --remote --output d1-backup.sql",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "classnames": "2.5.1",
    "date-fns": "^4.1.0",
    "gsap": "3.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "logrocket": "12.1.0",
    "logrocket-react": "7",
    "motion": "12.23.24",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "postcss": "8.5.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "swr": "2.4.1",
    "tailwindcss": "^4.0.15",
    "typescript": "5.9.3",
    "use-breakpoint": "4.0.10"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/mdx": "^2.0.14",
    "@types/react-dom": "19",
    "babel-plugin-react-compiler": "^1.0.0",
    "wrangler": "^4.123.0"
  }
}
