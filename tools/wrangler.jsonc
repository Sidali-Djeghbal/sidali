{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "sidali-tools",
	"main": "index.js",
	"compatibility_date": "2026-08-14",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sidali-notes",
			"database_id": "7c34ca49-2cf8-4ec0-9781-899612665571"
		}
	],
	"routes": [
		{
			"pattern": "tools.sidali-djeghbal.dev",
			"custom_domain": true
		}
	]
}
