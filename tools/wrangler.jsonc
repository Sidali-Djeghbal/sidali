{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "sidali-tools",
	"main": "index.js",
	"compatibility_date": "2026-08-14",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "tools.sidali-djeghbal.dev",
			"custom_domain": true
		}
	]
}
